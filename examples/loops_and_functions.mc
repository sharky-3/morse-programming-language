# Example: For loop
for i in range(5):
  print i

# Example: While loop
var count = 0
while count < 3:
  print count
  var count = count + 1

# Example: Function without return
func greet():
  print hello
  print world

greet()

# Example: Function with return
func add(a b):
  return a + b

var result = add(3 5)
print result
